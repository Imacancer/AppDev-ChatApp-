{
  "expo": {
    "name": "chat-app",
    "slug": "chat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manuel1.chatapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.manuel1.chatapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "vapidPublicKey": "BDxNEx8vC-QznN6uT7JdTQVfVmYkdxHMK3MqKPZRQmSPAwLf349v5jYDFibvVWM8_u12Seg9pWmYflCuBnXykwc",
      "serviceWorkerPath": "/expo-service-worker.js"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "applicationId": "com.manuel1.chatapp",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6e1b4493-87f8-4d94-be1b-dcb1d48fe20a"
      }
    }
  }
}
